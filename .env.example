# Copy to .env and fill in. Never commit your real .env.

# --- ClickHouse (ClickHouse Cloud: Connect -> "Use your own client") ---
CLICKHOUSE_HOST=your-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=default
TABLE_NAME=playback_events

# --- Google Cloud / Gemini (Vertex AI / Gemini Enterprise Agent Platform) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Many current Gemini models are served from the "global" endpoint; "us-central1" also works.
GOOGLE_CLOUD_LOCATION=global
# Set to a model your project can access (e.g. a Gemini 2.5 or 3.x model).
GEMINI_MODEL=gemini-2.5-flash

# --- Data access engine: "direct" (default) or "mcp" ---
ENGINE=direct
# Command that launches the ClickHouse MCP server (only used when ENGINE=mcp).
MCP_COMMAND=mcp-clickhouse
